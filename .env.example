# Copy this file to .env.local and fill in the two values.
# Find them in Supabase: Project Settings > API (or the "Connect" button).
# Leave both empty to run the demo on browser storage only, with no database.

# Project URL, like https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=

# The public "anon" key (or "publishable" key). Safe for the browser.
# NEVER use the service_role or secret key here.
VITE_SUPABASE_ANON_KEY=
